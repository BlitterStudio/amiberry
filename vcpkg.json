{
  "name": "amiberry",
  "version": "8.5.0",
  "description": "Optimized Amiga emulator for various platforms",
  "homepage": "https://amiberry.com",
  "dependencies": [
    "sdl3",
    {
      "name": "sdl3-image",
      "features": [
        "png"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "platform": "!(windows & arm64)",
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "libwebp",
    "libflac",
    {
      "name": "mpg123",
      "platform": "!(windows & arm64)"
    },
    "libpng",
    "zlib",
    "zstd",
    "enet",
    "libiconv",
    "curl",
    "nlohmann-json"
  ]
}
