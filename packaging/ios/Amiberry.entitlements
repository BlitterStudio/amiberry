<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS runs the 68K interpreter only: JIT support is compiled out via
	     AMIBERRY_IOS in src/osdep/sysconfig.h, so no JIT entitlement is
	     requested (App Store builds would not be granted one anyway). -->
</dict>
</plist>
